{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.closeyour.it/contracts/jobs/v1/schema.json",
  "$defs": {
    "job_context": {
      "type": "object",
      "required": [
        "schema_version",
        "framework",
        "name",
        "attempt_outcome",
        "terminal"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "framework": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "queue": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "job_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "attempt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "retry_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "measurement": {
          "enum": [
            "duration",
            "queue_wait"
          ]
        },
        "attempt_outcome": {
          "enum": [
            "success",
            "error",
            "retry",
            "discarded",
            "revoked",
            "unknown"
          ]
        },
        "terminal": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "clock_skew": {
          "type": "boolean"
        },
        "enqueued_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        },
        "scheduled_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        },
        "duration_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "queue_wait_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "scheduled_delay_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "attempt_outcome": {
                "const": "retry"
              }
            }
          },
          "then": {
            "properties": {
              "terminal": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "attempt_outcome": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "terminal": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
