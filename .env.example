# Optional consumer configuration. The SDK itself requires no environment
# variables to install, test, or build.
CLOSEYOURIT_ENDPOINT_URL=
CLOSEYOURIT_TOKEN=
CLOSEYOURIT_PROJECT_ID=
CLOSEYOURIT_ENVIRONMENT=development
CLOSEYOURIT_RELEASE=
# Opt-in usage telemetry: which registered symbols the application actually runs.
CLOSEYOURIT_USAGE_ENABLED=false
